# =============================================================================
# HireHub Backend – Environment Variables Example
# Copy this file to .env for local development. NEVER commit .env to Git.
# On Render, set these in: Dashboard → Service → Environment
# =============================================================================

# Django secret key — generate a strong random key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-secret-key

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
# Local dev: localhost,127.0.0.1
# Render: hirehub-backend.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173
# Render: https://hirehub-frontend.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# CSRF trusted origins (same as CORS for a typical SPA setup)
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ── MySQL 8 Database ─────────────────────────────────────────────────────────
DB_NAME=hirehub_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Set USE_SQLITE=True ONLY for local dev when MySQL is unavailable
USE_SQLITE=False

# Maximum resume upload size in MB
MAX_RESUME_SIZE_MB=5

# Absolute path to media/uploads directory (resumes)
# Default: ../media (relative to backend/)
# On Render with Persistent Disk: /var/data/media
MEDIA_ROOT=
