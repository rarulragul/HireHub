# =============================================================================
# HireHub Frontend – Environment Variables Example
# Copy this to .env for local development. NEVER commit .env to Git.
# On Render (static site), set these in: Dashboard → Service → Environment
# =============================================================================

# The full URL of the deployed Django backend API (no trailing slash)
# Local dev:  http://127.0.0.1:8000/api
# Render:     https://hirehub-backend.onrender.com/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api
