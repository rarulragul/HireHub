# =============================================================================
# HireHub – .gitignore
# =============================================================================

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
MANIFEST

# Virtual environments
backend/venv/
venv/
ENV/
env/
.venv/
venv.bak/
env.bak/

# ── Django ────────────────────────────────────────────────────────────────────
*.sqlite3
*.sqlite3-journal
*.log
local_settings.py

# Collected static (generated by collectstatic)
backend/staticfiles/

# ── Environment / Secrets ────────────────────────────────────────────────────
# NEVER commit .env files — they contain passwords and secret keys
.env
.envrc
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# ── Media / Resumes ──────────────────────────────────────────────────────────
media/
# Keep the media directory tracked but not its contents
!media/.gitkeep

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
node_modules/

# ── Testing / Coverage ───────────────────────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.lcov
.hypothesis/
.pytest_cache/
backend/.pytest_cache/

# ── Build / Distribution ─────────────────────────────────────────────────────
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/

# ── IDE / Editors ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
tempCodeRunnerFile.py

# ── Type Checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
cython_debug/
.ruff_cache/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
*.mo
*.pot
.pdm-python
.pdm-build/
__pypackages__/
.pypirc
.abstra/
.pixi/*
!.pixi/config.toml
.pybuilder/
